{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=knowledgeops.db"
  },
  "CopilotHistory": {
    "MaxModelMessages": 8,
    "MaxDisplayMessages": 50,
    "SummarizeAfterMessages": 5,
    "MessagesToKeepAfterSummary": 5,
    "ConversationRelevanceHours": 24,
    "RetentionDays": 10,
    "CleanupIntervalDays": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
